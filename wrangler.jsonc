// Cloudflare Workers の設定。静的なファイル（dist）だけを配信する。
// 手順は docs/deploy.md を参照。
{
  "name": "tochikan",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // PRごとのお試し版（Worker Previews）を作る `wrangler preview` に必要。
  // 中身は空でよい（assets などの設定は上のものがそのまま使われる）
  "previews": {},
}
